# Copy of what ci/bootstrap.sh generates in ci/.env (the real file is git-ignored).
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
SONAR_ADMIN_PASSWORD=Ss1!change-me-to-something-long
SONAR_DB_PASSWORD=change-me
SONAR_TOKEN=
LEDGER_HMAC_KEY=change-me
SECURESHIP_REPO_URL=https://github.com/<your-user>/SecureShip-DevSecOps-Pipeline.git
SECURESHIP_BRANCH=main
APP_REPO_URL=https://github.com/<your-user>/shoppilot.git
# Only for a PRIVATE ShopPilot repo (bootstrap.sh asks for it): fine-grained token, Contents: Read-only
APP_GIT_USER=
APP_GIT_TOKEN=
APP_GIT_CREDENTIALS_ID=
