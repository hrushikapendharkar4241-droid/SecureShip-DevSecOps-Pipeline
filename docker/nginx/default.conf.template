# Rendered by the nginx image entrypoint (envsubst) – only ${API_UPSTREAM} is substituted.
# API_UPSTREAM=http://backend:8000/   -> /api/auth/login is forwarded as /auth/login  (ShopPilot: routes have no prefix) [default]
# API_UPSTREAM=http://backend:8000    -> /api/auth/login is forwarded unchanged       (for apps whose routes start with /api)
server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 20m;   # scanner photos (15 MB max) and imported files (10 MB max)

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;

    location = /health {
        proxy_pass http://backend:8000/health;
        proxy_set_header Host $host;
        # ShopPilot sets its own security headers; hide them so the browser gets exactly one set (NGINX's)
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        access_log off;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;   # OCR requests can take a while
        # ShopPilot sets its own security headers; hide them so the browser gets exactly one set (NGINX's)
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
